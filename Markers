Parent alignment script
#!/usr/bin/env bash
set -euo pipefail
NUM_CORES=6
MAIN="/sciclone/data10/akraffetto/F2_cuplut"
REF="/sciclone/data10/akraffetto/mimulustest/1_genome_index/Mimulus_cupreus"
OUT="$MAIN/2-SAM"
LOG="$MAIN/Log_align_parents.txt"
TEMPLATE="$MAIN/align_scripts/align_tmp_PE.tcsh"

mkdir -p "$OUT"
echo "Starting : $(date)" > "$LOG"

for file in $MAIN/parent_fastq/*_R1_001.fastq.gz; do
    base=${file##*/}
    R2=${file%_R1_001.fastq.gz}_R2_001.fastq.gz
    sample_name=$(echo "$base" | cut -d"_" -f1)   # Cy or V

    outfile=$OUT/${sample_name}_parent.sam
    start_time=$(date +%s)

    cat "$TEMPLATE" \
    | sed "s,@@NUM_CORES@@,$NUM_CORES,g" \
    | sed "s,@@REF@@,$REF,g" \
    | sed "s,@@file@@,$file,g" \
    | sed "s,@@R2@@,$R2,g" \
    | sed "s,@@outfile@@,$outfile,g" \
    | sed "s,@@LOG@@,$LOG,g" \
    | sed "s,@@sample_name@@,$sample_name,g" \
    | sed "s,@@start_time@@,$start_time,g" \
    | sbatch
done
echo 'Process complete : ' $(date) >> "$LOG"

