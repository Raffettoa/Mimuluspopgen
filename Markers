#!/usr/bin/env bash
set -euo pipefail
NUM_CORES=6
MAIN="/sciclone/data10/akraffetto/F2_cuplut"
REF="/sciclone/data10/akraffetto/mimulustest/1_genome_index/Mimulus_cupreus"
OUT="$MAIN/2-SAM"
LOG="$MAIN/Log_align_F2.txt"
TEMPLATE="$MAIN/align_scripts/align_tmp_SE.tcsh"

mkdir -p "$OUT"
echo "Starting : $(date)" > "$LOG"

shopt -s nullglob
for file in $MAIN/fastq_reads/Plate_*/*/sample_*.fq.gz \
            $MAIN/fastq_reads/Plate_*/*/sample_*.fq \
            $MAIN/fastq_reads/Plate_1_aug/Plate_1_fastq_files/sample_*.fq.gz \
            $MAIN/fastq_reads/Plate_1_aug/Plate_1_fastq_files/sample_*.fq; do

    base=${file##*/}
    sample_name=${base%%.*}        # e.g. sample_245 from sample_245.fq.gz or sample_245.2.fq.gz
    
    # Skip the .2 mate files if any slipped in - shouldn't exist for SE plates but just in case
    case "$base" in
        *.2.fq*) continue ;;
    esac

    outfile=$OUT/${sample_name}.sam
    start_time=$(date +%s)

    cat "$TEMPLATE" \
    | sed "s,@@NUM_CORES@@,$NUM_CORES,g" \
    | sed "s,@@REF@@,$REF,g" \
    | sed "s,@@file@@,$file,g" \
    | sed "s,@@outfile@@,$outfile,g" \
    | sed "s,@@LOG@@,$LOG,g" \
    | sed "s,@@sample_name@@,$sample_name,g" \
    | sed "s,@@start_time@@,$start_time,g" \
    | sbatch
done
echo 'Process complete : ' $(date) >> "$LOG"

