#!/bin/tcsh
#SBATCH --job-name=@@sample_name@@
#SBATCH -N 1
#SBATCH --ntasks-per-node 10
#SBATCH --mem=64G
#SBATCH -t 24:00:00
module load miniforge3/24.9.2-0
conda activate mimulus

echo "Starting filter for @@sample_name@@ : `date`"

samtools view -bS -F 4 -q 20 @@input_sam@@ \
    | samtools sort -@ @@NUM_CORES@@ -m 4G -n -o @@MAPPED_OUT@@_namesort.bam
if ($status != 0) then
    echo "ERROR: view/namesort failed for @@sample_name@@"
    exit 1
endif

samtools fixmate -@ @@NUM_CORES@@ -m @@MAPPED_OUT@@_namesort.bam @@MAPPED_OUT@@_fixmate.bam
if ($status != 0) then
    echo "ERROR: fixmate failed for @@sample_name@@"
    exit 1
endif

samtools sort -@ @@NUM_CORES@@ -m 4G -o @@MAPPED_OUT@@_tmp.bam @@MAPPED_OUT@@_fixmate.bam
if ($status != 0) then
    echo "ERROR: coordinate sort failed for @@sample_name@@"
    exit 1
endif

samtools markdup -@ @@NUM_CORES@@ @@MAPPED_OUT@@_tmp.bam @@MAPPED_OUT@@
if ($status != 0) then
    echo "ERROR: markdup failed for @@sample_name@@"
    exit 1
endif

samtools index @@MAPPED_OUT@@
samtools idxstats --threads @@NUM_CORES@@ @@MAPPED_OUT@@ > @@STATS_OUT@@
rm @@MAPPED_OUT@@_namesort.bam @@MAPPED_OUT@@_fixmate.bam @@MAPPED_OUT@@_tmp.bam
echo "Done : `date`"


