#!/usr/bin/env bash
set -euo pipefail
MAIN="/sciclone/data10/akraffetto/F2_cuplut"
SAM_FILES="$MAIN/2-SAM"
MAPPED_OUTDIR="$MAIN/3-BAM"
STATS_DIR="$MAIN/3-BAM/stats"
LOG="$MAIN/Log_filter_sam_parents.txt"
TEMPLATE="$MAIN/align_scripts/filter_SAM_parents.tcsh"
NUM_CORES=10
echo "Starting : $(date)" > "$LOG"
for file in "$SAM_FILES"/Cy_parent.sam "$SAM_FILES"/V_parent.sam; do
    base=${file##*/}
    sample_name=${base/.sam/}
    MAPPED_OUT="$MAPPED_OUTDIR/${sample_name}.bam"
    STATS_OUT="$STATS_DIR/${sample_name}.idxstats.txt"
    cat "$TEMPLATE" \
    | sed "s,@@input_sam@@,$file,g" \
    | sed "s,@@MAPPED_OUT@@,$MAPPED_OUT,g" \
    | sed "s,@@STATS_OUT@@,$STATS_OUT,g" \
    | sed "s,@@sample_name@@,$sample_name,g" \
    | sed "s,@@NUM_CORES@@,$NUM_CORES,g" \
    | sbatch
    echo "Submitted $sample_name" >> "$LOG"
done
echo 'Process complete : ' $(date) >> "$LOG"

